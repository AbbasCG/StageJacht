# ─── Website ───────────────────────────────────────────────
# Lokaal: http://localhost:3000. Online: het adres van je website, zonder / aan het eind.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database (PostgreSQL) ─────────────────────────────────
# Met docker compose (zie docker-compose.yml) is dit precies goed:
DATABASE_URL=postgresql://stagejacht:stagejacht@localhost:5432/stagejacht

# ─── Cv-bestanden ──────────────────────────────────────────
# Map waar geüploade cv's komen te staan (standaard ./data/cv)
UPLOAD_DIR=./data/cv

# ─── Inloggen met Google en Gmail ──────────────────────────
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI: http://localhost:3000/auth/callback  (online: jouwdomein/auth/callback)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Testlogin zonder Google, alleen voor lokaal testen. NOOIT aanzetten op een echte server.
DEV_LOGIN=1
NEXT_PUBLIC_DEV_LOGIN=1

# Sleutel om Gmail-tokens versleuteld op te slaan (32 bytes, base64)
# Maak er een met: npm run genkey
TOKEN_ENCRYPTION_KEY=

# ─── AI (Anthropic) ────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Model voor mails schrijven en cv-advies
ANTHROPIC_MODEL=claude-sonnet-5-5
# Goedkoper model voor reacties beoordelen
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# ─── Internet doorzoeken (optioneel) ───────────────────────
# Brave Search API (brave.com/search/api). Zonder sleutel zoekt Stagejacht alleen op Stagemarkt.
BRAVE_SEARCH_API_KEY=

# ─── Mollie (betalen, alleen nodig voor abonnementen) ──────
# Mollie Dashboard → Developers → API keys (begin met test_, later live_)
MOLLIE_API_KEY=test_...

# ─── Geplande taken ────────────────────────────────────────
# Willekeurige lange tekst; npm run cron:mail stuurt hem mee naar /api/cron/*
# minimaal 16 tekens, bijvoorbeeld: openssl rand -hex 32
CRON_SECRET=
# Waar de app lokaal draait (voor npm run cron:...)
CRON_BASE_URL=http://localhost:3000
